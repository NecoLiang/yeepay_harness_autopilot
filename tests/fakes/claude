#!/usr/bin/env python3
"""Stand-in for `claude -p`: fixes the seeded bug, commits, writes a ready report, prints a JSON result."""
import json, pathlib, subprocess, sys
prompt = sys.stdin.read()
args = sys.argv[1:]
session = args[args.index("--session-id") + 1] if "--session-id" in args else args[args.index("--resume") + 1]
report = pathlib.Path(prompt.split("`")[-2])
calc = pathlib.Path("src/main/java/com/yeepay/demo/split/SplitCalculator.java")
text = calc.read_text(encoding="utf-8")
if "double total = orderAmount.doubleValue();" in text:
    calc.write_text(text.replace("double total = orderAmount.doubleValue();", "BigDecimal total = orderAmount;"), encoding="utf-8")
    r = subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@e", "commit", "-qam", "fix: split"], capture_output=True, text=True)
    if r.returncode: sys.exit("commit failed: " + r.stdout + r.stderr)
report.write_text(json.dumps({"state": "ready", "message": "修好了", "pr_title": "fix: split", "pr_body": "body"}), encoding="utf-8")
print(json.dumps({"type": "result", "session_id": session, "result": "ok", "is_error": False,
                  "total_cost_usd": 0.1, "duration_ms": 10, "num_turns": 2}))
